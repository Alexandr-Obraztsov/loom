{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["eslint.rules.js"]
    },
    "packages/kernel": {
      "entry": ["src/index.ts", "src/node/index.ts", "test/**/*.test.ts", "bench/**/*.bench.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts", "bench/**/*.ts"]
    },
    "packages/host": {
      "entry": ["src/index.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/sdk": {
      "entry": ["src/index.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/react": {
      "entry": ["src/index.ts", "test/**/*.test.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}", "test/**/*.{ts,tsx}"]
    },
    "plugins/acp": {
      "entry": ["src/main.ts", "src/renderer.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "plugins/claude-code": {
      "entry": ["src/main.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "plugins/storage": {
      "entry": ["src/main.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "plugins/app": {
      "entry": ["src/renderer.tsx", "src/api.ts", "test/**/*.test.tsx"],
      "project": ["src/**/*.{ts,tsx}", "test/**/*.{ts,tsx}"]
    },
    "plugins/layout-bare": {
      "entry": ["src/renderer.tsx", "test/**/*.test.tsx"],
      "project": ["src/**/*.{ts,tsx}", "test/**/*.{ts,tsx}"]
    },
    "plugins/chat": {
      "entry": ["src/renderer.tsx", "test/**/*.test.tsx"],
      "project": ["src/**/*.{ts,tsx}", "test/**/*.{ts,tsx}"]
    }
  },
  "ignore": ["tools/lint-fixtures/**"]
}
